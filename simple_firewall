int packet_filter(struct xdp_md *ctx) {
  void* data_end = (void*)(long)ctx->data_end;
  void* data = (void*)(long)ctx->data;
  struct ethhdr *eth = data;
  u64 zero64=0;
  u32 zero32=0;
  u16 zero16=0;
  u64 nh_off = sizeof(*eth);
  u64 eth_source, eth_dest;
  struct packet_event_t event;
  event.eth_source = zero64;
  event.eth_dest = zero64;
  event.eth_proto = zero16;
  event.ip_protocol = zero32;
  event.v4_source = zero32;
  event.v4_dest = zero32;
  event.port_source = zero16;
  event.port_dest = zero16;
  event.arp_opcode = zero16;
  event.arp_source_ip = zero32;
  event.arp_target_ip = zero32;
  event.arp_source_mac = zero64;
  event.arp_target_mac = zero64;

  struct packet_test_flags_t test_flags;
  test_flags.ip_protocol = zero32;
  test_flags.port = zero32;
  u32 *test_flag_val;

  u32 test_flag_key = TEST_FLAG_ETH_PROTOCOL;
  test_flag_val = testFlags.lookup_or_init(&test_flag_key, &zero32);
  if (test_flag_val) {
    if ((*test_flag_val) == ENABLE) {
      test_flags.eth_protocol = ENABLE;
    }
  }

  test_flag_key = TEST_FLAG_IP_PROTOCOL;
  test_flag_val = testFlags.lookup_or_init(&test_flag_key, &zero32);
  if (test_flag_val) {
    if ((*test_flag_val) == ENABLE) {
      test_flags.ip_protocol = ENABLE;
    }
  }
  
  test_flag_key = TEST_FLAG_IP_PORT;
  test_flag_val = testFlags.lookup_or_init(&test_flag_key, &zero32);
  if (test_flag_val) {
    if ((*test_flag_val) == ENABLE) {
      test_flags.port = ENABLE;
    }
  }

  if (data + nh_off > data_end)
    return XDP_PASS;

  for (int i=0; i< ETH_ALEN ; i++) {
    eth_source = eth_source << 8;
    eth_dest = eth_dest << 8;
    eth_source = eth_source | (eth->h_source[i]);
    eth_dest = eth_dest | (eth->h_dest[i]);
  }
  event.eth_source = eth_source;
  event.eth_dest = eth_dest;
  eth_source = 0;
  eth_dest = 0;
  event.eth_proto = htons(eth->h_proto);

  if (event.eth_proto == ETH_P_IP) {
    struct iphdr *iph = data + nh_off;
    if ((void*)&iph[1] > data_end)
      return XDP_PASS;

    event.ip_protocol = iph->protocol;
    event.v4_source = iph->saddr;
    event.v4_dest = iph->daddr;

    int ip_hdr_len = iph->ihl *4;
    if (ip_hdr_len < sizeof(struct iphdr)) {
      return XDP_PASS;
    }

    if (event.ip_protocol == IPPROTO_TCP) {
      struct tcphdr *tcp = (struct tcphdr *)((unsigned char *)iph + ip_hdr_len);
      if ((void *)(tcp +1) > data_end) {
        return XDP_PASS;
      }
      u32 tcp_header_len = tcp->doff *4;
      if (tcp_header_len < sizeof (*tcp) || tcp_header_len > MAX_TCP_HEADER_BYTES) {
        return XDP_PASS;
      }
      event.port_source = ntohs(tcp->source);
      event.port_dest = ntohs(tcp->dest);
    } else if (event.ip_protocol == IPPROTO_UDP) {
      struct udphdr *udp = (struct udphdr *)((unsigned char *)iph + ip_hdr_len);
      if ((void *)(udp +1) > data_end) {
        return XDP_PASS;
      }
      if (udp->len < sizeof (*udp) ) {
            return XDP_PASS;
      }
      event.port_source = ntohs(udp->source);
      event.port_dest = ntohs(udp->dest);
    }
  } else if (event.eth_proto == ETH_P_ARP) {
    // Parse ARP header
    struct arphdr_eth_ipv4 *arp = (void *)(eth + 1);
    if ((void *)(arp + 1) > data_end)
        return XDP_PASS;

    // Validate: Ethernet hardware type, IPv4 protocol, correct lengths
    if (arp->ar_hrd != bpf_htons(ARPHRD_ETHER) ||
        arp->ar_pro != bpf_htons(ETH_P_IP) ||
        arp->ar_hln != 6 ||
        arp->ar_pln != 4)
        return XDP_PASS;

    event.arp_opcode = ntohs(arp->ar_op);
    event.arp_source_ip = arp->ar_sip;
    event.arp_target_ip = arp->ar_tip;
    for (int i=0; i< ETH_ALEN ; i++) {
      event.arp_source_mac = event.arp_source_mac << 8;
      event.arp_target_mac = event.arp_target_mac << 8;
      event.arp_source_mac = event.arp_source_mac | (arp->ar_sha[i]);
      event.arp_target_mac = event.arp_target_mac | (arp->ar_tha[i]);
    }
  }

  u8 check_mac =0;

  // 宛先MACアドレスの種類による区別
  if (event.eth_dest == MAC_BROADCAST) { // ブロードキャストの場合
    // MACのソースがサーバ等の装置なら通す
    eth_source = event.eth_source;
    u32 *val;
    val = serverMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        return XDP_PASS;
      }
    }
    // MACのソースアドレスが認められた端末か否かを確認
    val = allowMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        check_mac = 1;
      }
    }
  } else if ((event.eth_dest & MAC_MULTICAST_MASK) > 0) { // マルチキャストの場合
    // MACのソースがサーバ等の装置なら通す
    eth_source = event.eth_source;
    u32 *val;
    val = serverMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        return XDP_PASS;
      }
    }
    // MACのソースアドレスが認められた端末か否かを確認
    val = allowMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        check_mac = 1;
      }
    }
  } else { // ユニキャストの場合
    // MACのソースがサーバ等の装置なら通す
    eth_source = event.eth_source;
    u32 *val;
    val = serverMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        return XDP_PASS;
      }
    }
    // MACのソースアドレスが認められた端末か否かを確認
    val = allowMacRuleMap.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        // MACの宛先がサーバ類ならOKとする
        eth_dest = event.eth_dest;
        val = serverMAC.lookup_or_init(&eth_dest, &zero32);
        if (val) {
          if ((*val) == ENABLE) {
            check_mac = 1;
          }
        } else {
          check_mac = 2;
        }
      }
    }
  }

  if (check_mac ==0) { // MACチェックの結果が否の場合
    // アプリ層に通知を出してパケット廃棄
    packet_events.perf_submit(ctx, &event, sizeof(event));
    return XDP_DROP;
  }

  if (check_mac == 2) { // MACのソースが見とれられたもの，宛先がサーバ以外の場合はARP以外は廃棄
    if (event.eth_proto != ETH_P_ARP) {
      // アプリ層に通知を出してパケット廃棄
      packet_events.perf_submit(ctx, &event, sizeof(event));
      return XDP_DROP;
    }
  }

  if (test_flags.eth_protocol != ENABLE) {
    return XDP_PASS;
  }

  u32 *eth_protocol_val;
  eth_protocol_val = allowArpOpCode.lookup_or_init(&event.eth_proto, &zero32);
  if (eth_protocol_val) {
    if ((*eth_protocol_val) != ENABLE) {
      goto packet_drop;
    }
  } else {
    goto packet_drop;
  }

  if (event.eth_proto == ETH_P_IP) {
    if (test_flags.ip_protocol != ENABLE) {
      return XDP_PASS;
    }
    u32 *protocol_val;
    protocol_val = allowIpProtocolList.lookup_or_init(&event.protocol, &zero32);
    if (protocol_val) {
      if ((*protocol_val) != ENABLE) {
        goto packet_drop;
      } else {
        if (event.protocol == IPPROTO_TCP) {
          if (test_flags.port != ENABLE) {
            goto packet_pass;
          }
          u32 *port_val;
          port_val = allowPortListTCP.lookup_or_init(&event.port_dest, &zero32);
          if (port_val) {
            if ((*port_val) == ENABLE) {
              goto packet_pass;
            } else {
              goto packet_drop;
            }
          } else {
            goto packet_drop;
          }
        } else if (event.protocol == IPPROTO_UDP) {
          if (test_flags.port != ENABLE) {
            goto packet_pass;
          }
          u32 *port_val;
          port_val = allowPortListUDP.lookup_or_init(&event.port_dest, &zero32);
          if (port_val) {
            if ((*port_val) == ENABLE) {
              goto packet_pass;
            } else {
              goto packet_drop;
            }
          } else {
            goto packet_drop;
          }
        }
      }
    }
  } else (event.eth_proto == ETH_P_ARP) {
    if (test_flags.ip_protocol != ENABLE) {
      return XDP_PASS;
    }
    u32 *arp_opcode_val;
    arp_opcode_val = allowArpOpCode.lookup_or_init(&event.arp_opcode, &zero32);
    if ((*arp_opcode_val) == ENABLE) {
      goto packet_pass;
    } else {
      goto packet_drop;
    }
  }


packet_pass:
  return XDP_PASS;

packet_drop:
  packet_events.perf_submit(ctx, &event, sizeof(event));
  return XDP_DROP;
}
