BPF_PERF_OUTPUT(packet_events);

int packet_filter(struct xdp_md *ctx) {
  void* data_end = (void*)(long)ctx->data_end;
  void* data = (void*)(long)ctx->data;
  struct ethhdr *eth = data;
  u64 zero64=0;
  u32 zero32=0;
  u16 zero16=0;
  u64 nh_off = sizeof(*eth);
  u64 eth_source, eth_dest;
  struct packet_event_t event;
  event.eth_source = zero64;
  event.eth_dest = zero64;
  event.protocol = zero32;
  event.v4_source = zero32;
  event.v4_dest = zero32;
  event.port_source = zero16;
  event.port_dest = zero16;

  struct packet_test_flags_t test_flags;
  test_flags.protocl = zero32;
  test_flags.port = zero32;
  u32 *test_flag_val;
  u32 test_flag_key = 0;
  test_flag_val = testFlags.lookup_or_init(&test_flag_key, &zero32);
  if (test_flag_val) {
    if ((*test_flag_val) == ENABLE) {
      test_flags.protocl = ENABLE;
    }
  }

  u32 test_flag_key = 1;
  test_flag_val = testFlags.lookup_or_init(&test_flag_key, &zero32);
  if (test_flag_val) {
    if ((*test_flag_val) == ENABLE) {
      test_flags.port = ENABLE;
    }
  }

  if (data + nh_off > data_end)
    return XDP_PASS;

  for (int i=0; i< ETH_ALEN ; i++) {
    eth_source = eth_source << 8;
    eth_dest = eth_dest << 8;
    eth_source = eth_source | (eth->h_source[i]);
    eth_dest = eth_dest | (eth->h_dest[i]);
  }
  event.eth_source = eth_source;
  event.eth_dest = eth_dest;
  eth_source = 0;
  eth_dest = 0;

  u8 check_mac =0;

  // MACアドレスの分類
  //packet_events.perf_submit(ctx, &event, sizeof(event));
  if (event.eth_dest == MAC_BROADCAST) { // ブロードキャストの場合
    // MACのソースがサーバ等の装置なら通す
    eth_source = event.eth_source;
    u32 *val;
    val = serverMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        //check_mac = 1;
        return XDP_PASS;
      }
    }
    if (check_mac ==0) { // MACチェックの結果が否の場合
      // MACのソースアドレスが認められた端末か否かを確認
      val = allowMAC.lookup_or_init(&eth_source, &zero32);
      if (val) {
        if ((*val) == ENABLE) {
          check_mac = 1;
        }
      }
    }
    //if (check_mac ==0) { // MACチェックの結果が否の場合
    //  // IPレベルの情報を取得した上で，アプリ層に通知を出してパケット廃棄
    //  if (eth->h_proto == htons(ETH_P_IP)) {
    //    struct iphdr *iph = data + nh_off;
    //    if ((void*)&iph[1] > data_end)
    //      return XDP_PASS;
    //    event.protocol = iph->protocol;
    //    event.v4_source = iph->saddr;
    //    event.v4_dest = iph->daddr;
    //  }
    //  //packet_events.perf_submit(ctx, &event, sizeof(event));
    //  //return XDP_DROP;
    //}
    //return XDP_PASS;
  } else if ((event.eth_source & MAC_MULTICAST_MASK) > 0) { // マルチキャストの場合
    // MACのソースがサーバ等の装置なら通す
    eth_source = event.eth_source;
    u32 *val;
    val = serverMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        //check_mac = 1;
        return XDP_PASS;
      }
    }
    if (check_mac ==0) { // MACチェックの結果が否の場合
      val = allowMAC.lookup_or_init(&eth_source, &zero32);
      if (val) {
        if ((*val) == ENABLE) {
          check_mac = 1;
        }
      }
    }
    //if (check_mac ==0) { // MACチェックの結果が否の場合
    //  // IPレベルの情報を取得した上で，アプリ層に通知を出してパケット廃棄
    //  if (eth->h_proto == htons(ETH_P_IP)) {
    //    struct iphdr *iph = data + nh_off;
    //    if ((void*)&iph[1] > data_end)
    //      return XDP_PASS;
    //    event.protocol = iph->protocol;
    //    event.v4_source = iph->saddr;
    //    event.v4_dest = iph->daddr;
    //  }
    //  packet_events.perf_submit(ctx, &event, sizeof(event));
    //  return XDP_DROP;
    //}
    //return XDP_PASS;
  } else { // ユニキャストの場合
    eth_source = event.eth_source;
    u32 *val;
    val = serverMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        //check_mac = 1;
        return XDP_PASS;
      }
    }
    val = allowMAC.lookup_or_init(&eth_source, &zero32);
    if (val) {
      if ((*val) == ENABLE) {
        eth_dest = event.eth_dest;
        val = serverMAC.lookup_or_init(&eth_dest, &zero32);
        if (val) {
          if ((*val) == ENABLE) {
            check_mac = 1;
          }
        }
      }
    }
    //if (check_mac ==0) { // MACチェックの結果が否の場合
    //  // IPレベルの情報を取得した上で，アプリ層に通知を出してパケット廃棄
    //  if (eth->h_proto == htons(ETH_P_IP)) {
    //    struct iphdr *iph = data + nh_off;
    //    if ((void*)&iph[1] > data_end)
    //      return XDP_PASS;
    //    event.protocol = iph->protocol;
    //    event.v4_source = iph->saddr;
    //    event.v4_dest = iph->daddr;
    //  }
    //  packet_events.perf_submit(ctx, &event, sizeof(event));
    //  return XDP_DROP;
    //}
  }

  if (test_flags.protocl != ENABLE) {
    if (check_mac ==0) { // MACチェックの結果が否の場合
      // IPレベルの情報を取得した上で，アプリ層に通知を出してパケット廃棄
      if (eth->h_proto == htons(ETH_P_IP)) {
        struct iphdr *iph = data + nh_off;
        if ((void*)&iph[1] > data_end) {
          //return XDP_PASS;
          packet_events.perf_submit(ctx, &event, sizeof(event));
          return XDP_DROP;
        }
        event.protocol = iph->protocol;
        event.v4_source = iph->saddr;
        event.v4_dest = iph->daddr;
      }
      packet_events.perf_submit(ctx, &event, sizeof(event));
      return XDP_DROP;
    } else {
      return XDP_PASS;
    }
  }

  if (eth->h_proto == htons(ETH_P_IP)) {
    struct iphdr *iph = data + nh_off;
    if ((void*)&iph[1] > data_end)
      return XDP_PASS;

    event.protocol = iph->protocol;
    event.v4_source = iph->saddr;
    event.v4_dest = iph->daddr;

    int ip_hdr_len = iph->ihl *4;
    if (ip_hdr_len < sizeof(struct iphdr)) {
      return XDP_PASS;
    }

    u32 *protocol_val;
    protocol_val = allowProtocolList.lookup_or_init(&event.protocol, &zero32);
    if (protocol_val) {
      if ((*protocol_val) != ENABLE) {
        goto packet_drop;
      } else {
        if (event.protocol == IPPROTO_TCP) {
          struct tcphdr *tcp = (struct tcphdr *)((unsigned char *)iph + ip_hdr_len);
          if ((void *)(tcp +1) > data_end) {
            goto packet_pass;
          }
          u32 tcp_header_len = tcp->doff *4;
          if (tcp_header_len < sizeof (*tcp) || tcp_header_len > MAX_TCP_HEADER_BYTES) {
            goto packet_pass;
          }
          event.port_source = ntohs(tcp->source);
          event.port_dest = ntohs(tcp->dest);
          if (test_flags.port != ENABLE) {
            goto packet_pass;
          }
          u32 *port_val;
          port_val = allowPortListTCP.lookup_or_init(&event.port_dest, &zero32);
          if (port_val) {
            if ((*port_val) == ENABLE) {
              goto packet_pass;
            } else {
              goto packet_drop;
            }
          } else {
            goto packet_drop;
          }
        } else if (event.protocol == IPPROTO_UDP) {
          struct udphdr *udp = (struct udphdr *)((unsigned char *)iph + ip_hdr_len);
          if ((void *)(udp +1) > data_end) {
            goto packet_pass;
          }
          if (udp->len < sizeof (*udp) ) {
            goto packet_pass;
          }
          event.port_source = ntohs(udp->source);
          event.port_dest = ntohs(udp->dest);
          if (test_flags.port != ENABLE) {
            goto packet_pass;
          }
          u32 *port_val;
          port_val = allowPortListUDP.lookup_or_init(&event.port_dest, &zero32);
          if (port_val) {
            if ((*port_val) == ENABLE) {
              goto packet_pass;
            } else {
              goto packet_drop;
            }
          } else {
            goto packet_drop;
          }
        }
      }
    }
  }
packet_pass:
  if (check_mac ==0) { // MACチェックの結果が否の場合
    packet_events.perf_submit(ctx, &event, sizeof(event));
    return XDP_DROP;
  }
  return XDP_PASS;

packet_drop:
  packet_events.perf_submit(ctx, &event, sizeof(event));
  return XDP_DROP;
}
