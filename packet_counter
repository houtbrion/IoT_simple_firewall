#!/usr/bin/env python
# -*- coding: utf-8 -*-

from bcc import BPF
import sys
import time

bpf_text = """
#include <uapi/linux/bpf.h>
#include <linux/ip.h>

BPF_HASH(packetcnt, u32, u32);

int xdp_packet_count(struct xdp_md *ctx) {

  u32 value = 0, protocol=0, *vp;

  vp = packetcnt.lookup_or_init(&protocol, &value);
  *vp += 1;

  return XDP_PASS;
}
"""

b = BPF(text=bpf_text)

#device = sys.argv[1]
#device = "enp0s3"
#device = "br0"
device = "wlan0"

interval = 10 # (sec)

b.attach_xdp(device, fn = b.load_func("xdp_packet_count", BPF.XDP))
packetcnt = b.get_table("packetcnt")
while True:
  try:
    packetcnt.clear()
    time.sleep(interval)
    for k, v in packetcnt.items():
      print("{} {}: {} pkt/s".format(time.strftime("%H:%M:%S"), k.value, (int(v.value)/interval)))
  except KeyboardInterrupt:
    break

b.remove_xdp(device)


