def print_packet_event(cpu,data,size):
  global b, ethProtocolList, ipProtocolList, ipPortList, arpOpCodeList
  event = b["packet_events"].event(data)

  if event.eth_proto in ethProtocolList:
    ethProtocolName = ethProtocolList[event.eth_proto]
  else:
    ethProtocolName = "unkown"
  if event.ip_protocol in ipProtocolList:
    ipProtocolName = ipProtocolList[event.ip_protocol]
  else:
    ipProtocolName = "unkown"
  if event.port_source in ipPortList:
    srcPortName = ipPortList[event.port_source]
  else:
    srcPortName = "unkown"
  if event.port_dest in ipPortList:
    destPortName = ipPortList[event.port_dest]
  else:
    destPortName = "unkown"
  if event.arp_opcode in arpOpCodeList:
    arpOpCodeName = arpOpCodeList[event.arp_opcode]
  else:
    arpOpCodeName = "unkown"

  print("- EtherProtocol: %-4x # %s\n" % (event.eth_proto, ethProtocolName))
  print("  EthSourceAddr: %-12lx # %-12lx\n" % (event.eth_source, event.eth_source))
  print("  EthDestAddr: %-12lx # %-12lx\n" % (event.eth_dest, event.eth_dest))
  print("  IpProtocol: %d # %s\n" % (event.ip_protocol, ipProtocolName))
  print("  IpSourceAddr: %-8x # %-16s\n" % (event.v4_source, inet_ntop(AF_INET, pack("I",event.v4_source)).encode()))
  print("  IpDestAddr: %-8x # %-16s\n" % (event.v4_dest, inet_ntop(AF_INET, pack("I",event.v4_dest)).encode()))
  print("  IpSourcePort: %d # %s\n" % (event.port_source, srcPortName))
  print("  IpDestPort: %d # %s\n" % (event.port_dest, destPortName))
  print("  ArpOpcode: %d # %s\n" % (event.arp_opcode, arpOpCodeName))
  print("  ArpSourceMac: %-12lx # %-12lx\n" % (event.arp_source_mac, event.arp_source_mac))
  print("  ArpTargetMac: %-12lx # %-12lx\n" % (event.arp_target_mac, event.arp_target_mac))
  print("  ArpSourceAddr: %-8x # %-16s\n" % (event.arp_source_ip, inet_ntop(AF_INET, pack("I",event.arp_source_ip)).encode()))
  print("  ArpTargetAddr: %-8x # %-16s\n" % (event.arp_target_ip, inet_ntop(AF_INET, pack("I",event.arp_target_ip)).encode()))

  #printb(b"%-5d %-2d %-12lx %-16s %-5d %-12lx %-16s %-5d %-5d %-16s %-16s %-12lx %-12lx" % (event.eth_proto, event.ip_protocol,
