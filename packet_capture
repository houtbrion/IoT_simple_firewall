#define MAX_TCP_HEADER_BYTES 60

#define MAC_BROADCAST    0xFFFFFFFFFFFF
#define MAC_MULTICAST_MASK 0x800000000000

#define ENABLE 1
#define DISABLE 0

struct arphdr_eth_ipv4 {
    __be16 ar_hrd;      // Hardware type (Ethernet = 1)
    __be16 ar_pro;      // Protocol type (IPv4 = 0x0800)
    __u8   ar_hln;      // Hardware address length (6 for MAC)
    __u8   ar_pln;      // Protocol address length (4 for IPv4)
    __be16 ar_op;        // ARP operation (1 = request, 2 = reply)
    __u8   ar_sha[6];   // Sender hardware address (MAC)
    __be32 ar_sip;      // Sender IP address
    __u8   ar_tha[6];   // Target hardware address (MAC)
    __be32 ar_tip;      // Target IP address
} __attribute__((packed));


struct packet_event_t {
  u16 eth_proto;
  u64 eth_source, eth_dest;
  u32 ip_protocol;
  u32 v4_source, v4_dest;
  u16 port_source, port_dest;
  u16 arp_opcode;
  u32 arp_source_ip, arp_target_ip;
  u64 arp_source_mac, arp_target_mac;
};

BPF_PERF_OUTPUT(packet_events);

int packet_capture(struct xdp_md *ctx) {
  void* data_end = (void*)(long)ctx->data_end;
  void* data = (void*)(long)ctx->data;
  struct ethhdr *eth = data;
  u64 zero64=0;
  u32 zero32=0;
  u16 zero16=0;
  u64 nh_off = sizeof(*eth);
  u64 eth_source, eth_dest;
  struct packet_event_t event;
  event.eth_source = zero64;
  event.eth_dest = zero64;
  event.eth_proto = zero16;
  event.ip_protocol = zero32;
  event.v4_source = zero32;
  event.v4_dest = zero32;
  event.port_source = zero16;
  event.port_dest = zero16;
  event.arp_opcode = zero16;
  event.arp_source_ip = zero32;
  event.arp_target_ip = zero32;
  event.arp_source_mac = zero64;
  event.arp_target_mac = zero64;

  if (data + nh_off > data_end)
    return XDP_PASS;

  for (int i=0; i< ETH_ALEN ; i++) {
    eth_source = eth_source << 8;
    eth_dest = eth_dest << 8;
    eth_source = eth_source | (eth->h_source[i]);
    eth_dest = eth_dest | (eth->h_dest[i]);
  }
  event.eth_source = eth_source;
  event.eth_dest = eth_dest;
  event.eth_proto = htons(eth->h_proto);

  if (event.eth_proto == ETH_P_IP) {
    struct iphdr *iph = data + nh_off;
    if ((void*)&iph[1] > data_end)
      return XDP_PASS;

    event.ip_protocol = iph->protocol;
    event.v4_source = iph->saddr;
    event.v4_dest = iph->daddr;

    int ip_hdr_len = iph->ihl *4;
    if (ip_hdr_len < sizeof(struct iphdr)) {
      return XDP_PASS;
    }

    if (event.ip_protocol == IPPROTO_TCP) {
      struct tcphdr *tcp = (struct tcphdr *)((unsigned char *)iph + ip_hdr_len);
      if ((void *)(tcp +1) > data_end) {
        return XDP_PASS;
      }
      u32 tcp_header_len = tcp->doff *4;
      if (tcp_header_len < sizeof (*tcp) || tcp_header_len > MAX_TCP_HEADER_BYTES) {
        return XDP_PASS;
      }
      event.port_source = ntohs(tcp->source);
      event.port_dest = ntohs(tcp->dest);
    } else if (event.ip_protocol == IPPROTO_UDP) {
      struct udphdr *udp = (struct udphdr *)((unsigned char *)iph + ip_hdr_len);
      if ((void *)(udp +1) > data_end) {
        return XDP_PASS;
      }
      if (udp->len < sizeof (*udp) ) {
            return XDP_PASS;
      }
      event.port_source = ntohs(udp->source);
      event.port_dest = ntohs(udp->dest);
    }
  } else if (event.eth_proto == ETH_P_ARP) {
    // Parse ARP header
    struct arphdr_eth_ipv4 *arp = (void *)(eth + 1);
    if ((void *)(arp + 1) > data_end)
        return XDP_PASS;

    // Validate: Ethernet hardware type, IPv4 protocol, correct lengths
    /*if (arp->ar_hrd != bpf_htons(ARPHRD_ETHER) ||
        arp->ar_pro != bpf_htons(ETH_P_IP) ||
        arp->ar_hln != 6 ||
        arp->ar_pln != 4)
        return XDP_PASS;*/
    if (arp->ar_hln != 6 ||
        arp->ar_pln != 4)
        return XDP_PASS;

    event.arp_opcode = ntohs(arp->ar_op);
    event.arp_source_ip = arp->ar_sip;
    event.arp_target_ip = arp->ar_tip;
    for (int i=0; i< ETH_ALEN ; i++) {
      event.arp_source_mac = event.arp_source_mac << 8;
      event.arp_target_mac = event.arp_target_mac << 8;
      event.arp_source_mac = event.arp_source_mac | (arp->ar_sha[i]);
      event.arp_target_mac = event.arp_target_mac | (arp->ar_tha[i]);
    }
  }

  packet_events.perf_submit(ctx, &event, sizeof(event));
  return XDP_PASS;
}
"""

